# Dependencies
node_modules/
brain-ui/node_modules/

# Brain engine
brain-engine/.venv/

# Satellite repos (replaced by your own clones during setup)
# Each satellite is autonomous with its own git remote.
# Placeholder READMEs are tracked to guide new users.
toolkit/*
!toolkit/README.md
profil/*
!profil/README.md
!profil/CLAUDE.md.example
# Les specs du PROGRAMME partent avec le gabarit (tranché le 04/09) — ce sont
# les données personnelles de profil/ qui restent au fork.
!profil/specs/
# La FORME de l'identité, sans contenu : un fork sait quoi remplir. `identity/`
# lui-même ne part jamais (BRAIN-056).
!profil/identity.exemple/
progression/*
!progression/README.md
reviews/*
!reviews/README.md
todo/*
!todo/README.md
# Ce qu'écrit une session `learning` : un satellite comme les autres.
learning/*
!learning/README.md
# BRAIN-080 — la vie (privée, jamais indexée) et la production (lue par le MCP).
vie/*
!vie/README.md
contenu/*
!contenu/README.md

# Le brouillon des sessions : volatile, jamais versionne (le dossier, seulement)
workspace/scratch/*
!workspace/scratch/.gitkeep
# Instance-specific (never committed)
# L'instantane du focus, reecrit a chaque passage de l'indexeur (toutes les 2 h)
focus.instantane.md
focus.instantane.md.tmp
brain-compose.local.yml
MYSECRETS
brain.db
brain-template.db
*.pid

# Dolt local data
brain-dolt/

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Claude Code
.claude/

# Logs
*.log

# agents/ est une vue de noyau/agents/ et instance/agents/, construite par `brain vue`
/agents/
