# brain-compose.local.yml — Registre machine
# NON VERSIONNÉ — gitignored. Spécifique à cette machine.
# Copier depuis brain-compose.local.yml.example, remplir, NE PAS commiter.

kernel_path: <BRAIN_ROOT>
kernel_version: "0.9.2"
last_kernel_sync: "<YYYY-MM-DD>"
machine: <MACHINE>          # identifiant court : desktop / laptop / vps / etc.

instances:
  prod:
    path: <BRAIN_ROOT>
    brain_name: prod
    feature_set: full
    config_status: hydrated   # hydrated / partial / empty
    active: true

  # Exemple — instance client ou template-test :
  # template-test:
  #   path: <BRAIN_ROOT>-test
  #   brain_name: template-test
  #   feature_set: full
  #   config_status: partial
  #   active: false

# ── Peers — les autres machines de CETTE instance (optionnel) ─────────────────
# `bsi-query.sh peers`, `bsi-signal.sh` et `bsi-peer-poll.sh` les joignent en SSH.
# peers:
#   laptop:
#     active: true
#     url: http://<ip-du-laptop>:7700
#     ssh_user: <compte>          # défaut : le compte qui lance ($USER)
#     brain_root: ~/Dev/Brain     # défaut : le chemin de CE brain, relatif à $HOME
