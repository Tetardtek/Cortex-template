#!/usr/bin/env bash
# brain-distribuable: oui
# post-merge — installé par scripts/install-brain-hooks.sh, source versionnée
#
# Une PR fusionnée arrive dans le checkout principal par `git merge --ff-only` :
# aucun post-commit ne se déclenche. Sans ce hook, un handoff créé ou consommé
# par une PR restait absent de la base tant qu'aucun commit local ne touchait
# handoffs/ — rien d'autre ne lance migrate.py. Git déclenche post-merge après
# toute fusion réussie, avance rapide comprise.

source "$(dirname "${BASH_SOURCE[0]}")/_racines.sh"
source "$(dirname "${BASH_SOURCE[0]}")/_vue.sh"
# La vue des agents suit la fusion — un `git pull` aussi, dans un worktree aussi.
vue_suit_le_checkout
brain_dans_un_worktree && exit 0

if git diff --name-only ORIG_HEAD HEAD 2>/dev/null | grep -qE '^(handoffs/|BRAIN-INDEX\.md)'; then
    bash "$BRAIN_MAIN/scripts/brain-db-sync.sh" --quiet || true
fi
