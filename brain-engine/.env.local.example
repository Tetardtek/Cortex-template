# brain-engine/.env.local — configuration de VOTRE instance
#
# Copier en `.env.local` et ajuster. Ce fichier n'est jamais distribué :
# `.env.local` est gitignoré, et seul cet exemple part avec le template.

# ── Le moteur de base ────────────────────────────────────────────────────────
# `dolt`   : le défaut — la base versionnée (BRAIN-074). `scripts/dolt-setup.sh`
#            installe Dolt, crée la base et le service, et écrit cette ligne.
# `sqlite` : un fichier, rien à installer — mais sans versionnement, le CORE
#            refuse les purges (l'indexation s'arrête quand un fichier sort
#            du corpus). À déclarer en connaissance de cause.
BRAIN_DB_BACKEND=dolt

# ── Si BRAIN_DB_BACKEND=dolt ─────────────────────────────────────────────────
# `scripts/dolt-setup.sh` installe Dolt, crée la base et le service, et écrit
# ce fichier. Les valeurs ci-dessous sont les défauts de `db.py` :
# BRAIN_DOLT_HOST=127.0.0.1
# BRAIN_DOLT_PORT=3307
# BRAIN_DOLT_USER=root
# BRAIN_DOLT_DB=brain-dolt
# BRAIN_DOLT_DIR=./brain-dolt

# ── Ports ────────────────────────────────────────────────────────────────────
# BRAIN_PORT=7700          API HTTP
# BRAIN_MCP_PORT=7701      serveur MCP
# BRAIN_BIND=127.0.0.1     adresse d'écoute des deux serveurs (défaut : la machine
#                          seule) ; 0.0.0.0 les ouvre au réseau — posez alors les jetons

# ── Embeddings — Ollama, en local ────────────────────────────────────────────
# OLLAMA_URL=http://localhost:11434
# EMBED_MODEL=nomic-embed-text

# ── Jetons ───────────────────────────────────────────────────────────────────
# ⚠️ SANS AUCUN JETON, L'ACCÈS EST TOTAL pour la machine elle-même.
#    Les deux serveurs écoutent sur 127.0.0.1 par défaut : la machine seule.
#    Ouverts au réseau (BRAIN_BIND), ils ne répondent sans jeton qu'à la machine
#    elle-même ; pour servir une autre machine, remplissez ces deux lignes.
#
# BRAIN_TOKEN=            rôle owner  — accès aux cinq zones
# BRAIN_TOKEN_MCP=        rôle mcp    — tout sauf `kernel`
